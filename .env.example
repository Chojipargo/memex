# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://sapiejhntzbhtiumvxty.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the upload and note routes to generate chunk embeddings.
# Claude has no embeddings API, so embeddings stay on Gemini.
# Create a key at https://aistudio.google.com/app/apikey.
GEMINI_API_KEY=

# Optional embedding configuration. The defaults match the migration
# (vector(1536)). If you change EMBEDDING_DIMENSIONS, update the migration and
# re-embed existing documents.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=1536

# Server-only. Used by POST /api/trails to generate trails with the Claude
# Messages API. Create a key at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=

# Optional trail generation model.
# CLAUDE_TRAIL_MODEL=claude-sonnet-5-5
# Used when the trail model stays overloaded (429/5xx). "none" disables it.
# CLAUDE_TRAIL_FALLBACK_MODEL=claude-haiku-5-5

# Server-only. Used when a question is not covered by the user's library, and
# by manual "Research the web" trails. Create a key at https://tavily.com.
# Without this key, library-only trails still work.
TAVILY_API_KEY=

# Optional. Best-match cosine similarity a question needs before the library
# alone answers it; below this, trails research the web. Raise it to research
# more often, lower it to stay local more often.
# TRAIL_COVERAGE_THRESHOLD=0.6
# Continuing a trail: weight of "near the current passage" vs "matches the question" (0-1).
# TRAIL_STEP_WEIGHT=0.5

# Optional, server-only. Only needed if you query Postgres directly
# (Drizzle / Prisma / pg). Never expose this to the browser.
# DATABASE_URL=postgresql://postgres:<password>@db.sapiejhntzbhtiumvxty.supabase.co:5432/postgres
