# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://sapiejhntzbhtiumvxty.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by POST /api/documents/upload to generate chunk embeddings.
# Create a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Optional embedding configuration. The defaults match the migration
# (vector(1536)). If you change EMBEDDING_DIMENSIONS, update the migration and
# re-embed existing documents.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Optional, server-only. Only needed if you query Postgres directly
# (Drizzle / Prisma / pg). Never expose this to the browser.
# DATABASE_URL=postgresql://postgres:<password>@db.sapiejhntzbhtiumvxty.supabase.co:5432/postgres
